# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string

# Database — SQLite for local/dev (default). PostgreSQL for production / smoke test.
DATABASE_URL=sqlite:///unitrack.db
# Optional Postgres (see docker-compose.postgres.yml + requirements-prod.txt):
# DATABASE_URL=postgresql://unitrack:unitrack@localhost:5432/unitrack
# Also accepted: postgres://… (normalized to postgresql://)

# CORS (admin-web + Expo)

# Speeding threshold (km/h)
SPEEDING_THRESHOLD_KMH=70

# Fuel estimate factor (km per liter) — Phase 5 admin maintenance view
FUEL_KM_PER_LITER=8.0

# Default university (single-tenant Phase 1)
UNIVERSITY_NAME=Demo University
UNIVERSITY_CODE=DEMO

# Seed admin (created on first run if missing)
ADMIN_EMAIL=admin@university.edu
ADMIN_PASSWORD=Admin@12345
