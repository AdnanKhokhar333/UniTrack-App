# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string

# Database — SQLite for local/dev; switch to PostgreSQL for production
DATABASE_URL=sqlite:///unitrack.db
# DATABASE_URL=postgresql://user:password@localhost:5432/unitrack

# CORS (admin-web + Expo)

# Speeding threshold (km/h)
SPEEDING_THRESHOLD_KMH=70

# Default university (single-tenant Phase 1)
UNIVERSITY_NAME=Demo University
UNIVERSITY_CODE=DEMO

# Seed admin (created on first run if missing)
ADMIN_EMAIL=admin@university.edu
ADMIN_PASSWORD=Admin@12345
