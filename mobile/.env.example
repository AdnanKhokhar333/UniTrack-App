# Point the Expo app at your Flask API.
#
# Emulator / simulator:
#   EXPO_PUBLIC_API_URL=http://localhost:5000
#   Android emulator alternative: http://10.0.2.2:5000
#
# Physical device (same Wi‑Fi as your PC):
#   EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:5000
#   Example: EXPO_PUBLIC_API_URL=http://192.168.1.42:5000
#   Find LAN IP: Windows `ipconfig` → IPv4 Address
#
EXPO_PUBLIC_API_URL=http://192.168.100.8:5000

# Google Maps SDK key (required for native Android/iOS MapView tiles).
# Leave empty until you paste a real key — never commit secrets.
# Enable Maps SDK for Android (+ Maps SDK for iOS) in Google Cloud Console,
# restrict by package edu.unitrack.app / bundle edu.unitrack.app, then:
#   1) set EXPO_PUBLIC_GOOGLE_MAPS_API_KEY below
#   2) restart with: npx expo start -c
#   3) test on Android/iOS device or emulator (not Expo web)
# Wired via app.config.js → ios.config.googleMapsApiKey + android.config.googleMaps.apiKey
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
